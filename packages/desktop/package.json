{
  "name": "@workdome/desktop",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "wait-on http-get://127.0.0.1:5173 && electron-vite dev --watch",
