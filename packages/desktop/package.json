    "lint": "oxlint",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workdome/server": "workspace:*",
    "@workdome/typescript-config": "workspace:*",
    "electron": "45.2.3",
    "electron-vite": "6.0.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wait-on": "9.5.1"
  }
}
