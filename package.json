{
  "name": "workdome",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:electron": "pnpm --filter @workdome/desktop dev",
    "lint": "turbo run lint && depcruise packages",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.node.json",
    "test": "turbo run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "knip": "knip --include dependencies"
  },
  "devDependencies": {
    "dependency-cruiser": "18.7.1",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
